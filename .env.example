# GodsView Command settings. Copy this file to .env and edit it.
# Variables set in your shell take precedence over this file.

# Where the console listens. Keep it on this machine: the GodsView MCP
# endpoint and the camera proxy are meant for local use only.
PORT=5050
HOST=127.0.0.1
# Open the console in your browser when it starts. 0 turns it off.
# OPEN_BROWSER=1

# God's Eye View ("GodsView"). When nothing answers at GEV_URL, the console
# starts GodsView from GEV_DIR with `npm run dev` (run `npm ci` there first).
GEV_URL=http://localhost:4173
GEV_DIR=../gods-eye-view
GEV_AUTOSTART=1
# Only when browsers reach the console or GodsView at other addresses than
# localhost (a reverse proxy, say). GitHub Codespaces sets these up itself.
# PUBLIC_URL=
# GEV_PUBLIC_URL=

# AI analyst (Claude). Leave empty if you use `ant auth login` instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Effort: low, medium, high, xhigh or max. Higher is more thorough and costs more.
# AI_EFFORT=medium

# Waze reports (police, accidents, hazards, closures).
#   livemap: the JSON endpoint behind waze.com/live-map. Not a published API;
#            Waze may refuse it, and usually refuses cloud/datacenter addresses.
#   feed:    your Waze for Cities (Connected Citizens Program) partner feed,
#            the supported option. Put its JSON URL in WAZE_FEED_URL.
#   off:     no Waze layer.
WAZE_MODE=livemap
# WAZE_FEED_URL=
# Waze live map region: na (US and Canada), row (rest of world) or il (Israel).
# WAZE_ENV=na

# The NWS API and OpenStreetMap Nominatim ask every client to identify itself
# with contact details. Put your email here.
NWS_USER_AGENT=GodsViewCommand/1.0 (you@example.com)

# Where the map opens the first time (lat,lon and zoom).
MAP_CENTER=30.2672,-97.7431
MAP_ZOOM=12
